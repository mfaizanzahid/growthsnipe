{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthsnipe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/auth/*",
      "/api/*",
      "/webhooks/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growthsnipe",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "./db/migrations"
    }
  ],
  "workflows": [
    {
      "name": "sync-workflow",
      "binding": "SYNC_WORKFLOW",
      "class_name": "SyncWorkflow"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "vars": {
    "SAFEPAY_ENV": "sandbox",
    "SAFEPAY_API_BASE": "https://sandbox.api.getsafepay.com",
    "APP_BASE_URL": "http://localhost:5173",
    "LOG_RETENTION_DAYS": "90"
  },
  "triggers": {
    "crons": ["0 3 * * *", "0 * * * *", "* * * * *"]
  },
  "env": {
    "production": {
      "vars": {
            "AI_MODEL": "gpt-6-luna",
 			"AI_PROVIDER": "openai",
 			"ANALYTICS_SYNC_VIA_WORKFLOW": "1",
			"APP_BASE_URL": "https://growthsnipe.com",
			"BREVO_NEW_SIGNUP_LIST_ID": "8",
			"BREVO_SENDER_EMAIL": "noreply@growthsnipe.com",
			"BREVO_SENDER_NAME": "GrowthSnipe",
			"BRIEFING_FROM_EMAIL": "briefings@growthsnipe.com",
			"DEFAULT_TIMEZONE": "America/New_York",
			"GOOGLE_CLIENT_ID": "980211207017-risgihuf4o6kqi8qc04cearg7svufpmr.apps.googleusercontent.com",
			"RESEND_FROM_EMAIL": "GrowthSnipe <noreply@growthsnipe.com>",
			"SAFEPAY_API_BASE": "https://sandbox.api.getsafepay.com",
			"SAFEPAY_ENV": "sandbox",
			"SUPERADMIN_EMAILS": "mfaizanzahid@gmail.com",
			"LOG_RETENTION_DAYS": "90"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "growthsnipe-db-prod",
          "database_id": "223a2e76-2b2a-4679-a10b-1cb26960e7ca",
          "migrations_dir": "./db/migrations"
        }
      ],
      "triggers": {
        "crons": ["0 3 * * *", "0 * * * *", "* * * * *"]
      },
      "workflows": [
        {
          "name": "sync-workflow",
          "binding": "SYNC_WORKFLOW",
          "class_name": "SyncWorkflow"
        }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "issue_detection": {
          "enabled": true
        }
      }
    }
  }
}
