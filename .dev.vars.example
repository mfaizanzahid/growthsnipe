# Local Workers secrets. Do not commit .dev.vars.
TOKEN_ENCRYPTION_KEY=

# Safepay Sandbox (server-only bindings; never expose to React)
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
# Dashboard "shared secret" (Developers -> Endpoints -> View shared secret).
# NOT the merchant secret key. Used to verify X-SFPY-SIGNATURE.
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox
SAFEPAY_API_BASE=https://sandbox.api.getsafepay.com
# Optional ISO 3166-1 alpha-2 fallback for customer creation.
#SAFEPAY_DEFAULT_COUNTRY=US

# Better Auth + app
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Sender identity for auth + billing emails, e.g. "Ostive App <noreply@alerts.ostive.com>"
# (kept as fallback; Brevo is the primary sender)
RESEND_FROM_EMAIL=
# Brevo (primary email provider): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Verified Brevo sender identity (Sender must be verified in Brevo)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tradesmatic
# Brevo contacts list for verified new signups ("Tradesmatic New Signup")
BREVO_NEW_SIGNUP_LIST_ID=8
APP_BASE_URL=http://localhost:5173
# Comma-separated owner emails seeded as superadmin on first login.
SUPERADMIN_EMAILS=

# Tradesmatic MCP (V1 market test; server-only, never expose to React)
MCP_BASE_URL=http://localhost:8787
MCP_TOKEN_PEPPER=
MCP_ENCRYPTION_KEY=
AI_PROVIDER=anthropic
# Optional model override for the OpenAI path (default: gpt-5.6-luna).
#AI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_TIMEZONE=America/New_York
BRIEFING_FROM_EMAIL=briefings@example.com

# Operator-configured embed snippets (chat widget, trackers) are NOT here: they
# live in wrangler.jsonc "vars" (plaintext - the snippet ships to every
# visitor of that surface and is visible in page source, so it must never
# hold a secret). Local development reads them from that file; add a key here
# only to override the value for your machine.
# Zoho SalesIQ chat widget - authenticated app pages only.
#EMBED_APP_HTML=<script>window.$zoho=window.$zoho || {};$zoho.salesiq=$zoho.salesiq||{ready:function(){}}</script><script id="zsiqscript" src="https://salesiq.zohopublic.com/widget?wc=REPLACE_ME" defer></script>
# Public marketing pages (chat widget, trackers).
#EMBED_MARKETING_HTML=
