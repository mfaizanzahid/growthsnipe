# Public app
VITE_APP_NAME=SaaS Billing Portal
VITE_APP_BASE_URL=http://localhost:5173
# Google Analytics measurement ID (optional; when empty, no tracking loads)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Embed snippets (chat widget, trackers) - injected as the last child of
# <body> on that surface. PUBLIC: these are inlined into the client bundle and
# ship to every visitor, so never put a secret in them. An empty value means
# "no snippet for this surface".
# IMPORTANT: in THIS .env file, escape every $ as \$ - a .env file is
# dotenv-expanded, so a bare $zoho would be replaced with an empty string and
# break the snippet. A Cloudflare BUILD VARIABLE is copied verbatim instead,
# so the same snippet goes in there with a plain $ (no backslash).
# VITE_EMBED_MARKETING_HTML -> public marketing pages
VITE_EMBED_MARKETING_HTML=
# VITE_EMBED_APP_HTML -> authenticated app pages
VITE_EMBED_APP_HTML=<script>window.\$zoho=window.\$zoho || {};\$zoho.salesiq=\$zoho.salesiq||{ready:function(){}}</script><script id="zsiqscript" src="https://salesiq.zohopublic.com/widget?wc=REPLACE_ME" defer></script>

# Server bindings (set in .dev.vars / Wrangler secrets, not VITE_)
# TOKEN_ENCRYPTION_KEY=
# SAFEPAY_PUBLIC_KEY=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_WEBHOOK_SECRET=
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY= (fallback sender; Brevo is primary)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=GrowthSnipe
# BREVO_NEW_SIGNUP_LIST_ID=8
# APP_BASE_URL=
# SUPERADMIN_EMAILS=

# Cloudflare
D1_DATABASE_NAME=saas-billing-portal
