# Public app
VITE_APP_NAME=SaaS Billing Portal
VITE_APP_BASE_URL=http://localhost:5173

# Google Analytics and operator embed snippets are NOT VITE_ values. They live
# in Worker runtime vars (wrangler.jsonc "vars": GA_MEASUREMENT_ID,
# EMBED_APP_HTML, EMBED_MARKETING_HTML) and are served to the browser by
# GET /api/runtime-config, so they can change without a client rebuild. They
# are public by design (visible in page source), so never put a secret in them.
# GA_MEASUREMENT_ID accepts a GA4/Ads/Floodlight ID (G-, AW-, DC-) or a Tag
# Manager container ID (GTM-). Add a key in .dev.vars only to override the
# value for one machine.

# Server bindings (set in .dev.vars / Wrangler secrets, not VITE_)
# TOKEN_ENCRYPTION_KEY=
# SAFEPAY_PUBLIC_KEY=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_WEBHOOK_SECRET=
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY= (fallback sender; Brevo is primary)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=GrowthSnipe
# BREVO_NEW_SIGNUP_LIST_ID=8
# APP_BASE_URL=
# SUPERADMIN_EMAILS=

# Cloudflare
D1_DATABASE_NAME=saas-billing-portal
